# Rust build output (any depth, so nested crates such as firmware/esp are covered)
target/
**/*.rs.bk

# Cargo lock is kept for the binary crates added later; uncomment only for pure libraries
# Cargo.lock

# WASM and PWA build output
/pwa/node_modules/
/pwa/out/
/pwa/wasm-pkg/
/pwa/.next/
/crates/tpt-ruc-wasm/pkg/

# ESP firmware build output
/crates/tpt-ruc-firmware/target/
/crates/tpt-ruc-firmware/.embuild/

# Hardware tool output (regenerate from sources)
/hardware/**/*-backups/
/hardware/**/*.bak
/hardware/**/*.lck

# Local data and secrets. Never commit device keys, API keys or trip data
/data/
*.env
.env.*
!.env.example
*.key
*.pem

# Editor and OS files
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
/pwa/next-env.d.ts
/pwa/*.tsbuildinfo
/pwa/test-results/
/pwa/playwright-report/
/firmware/esp/target/

# Built from pwa/lib/sw-sync-entry.ts by `npm run build:sw`
/pwa/public/sync-worker.js
