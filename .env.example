# Copy this file to .env to change settings. Every setting is optional.
# Leave a value blank or remove the line to use the default.

# Your API key. Leave blank to have one generated on first start.
# If you set it, use at least 32 characters. Keep it secret.
TPT_RUC_API_KEY=

# Browser apps that may call the API, comma-separated. Leave blank unless you
# host the PWA somewhere other than this server.
# Example: https://pwa.example.com
TPT_RUC_CORS_ORIGINS=
