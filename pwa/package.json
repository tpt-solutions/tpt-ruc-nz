{
  "name": "tpt-ruc-pwa",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "description": "Offline-first RUC tracker PWA for tpt-ruc-nz",
  "scripts": {
    "dev": "npm run build:sw && vite",
    "build": "npm run build:sw && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "licenses": "node scripts/check-licences.mjs",
    "build:sw": "rolldown lib/sw-sync-entry.ts --file public/sync-worker.js --format iife --platform browser --minify"
  },
  "dependencies": {
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tpt-ruc-wasm": "file:wasm-pkg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "license-checker": "25.0.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "rolldown": "1.2.14",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
